# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=10.42.4.19:9092
KAFKA_INPUT_TOPIC=olt_ont_registration
KAFKA_OUTPUT_TOPIC=registered_onu
KAFKA_CONSUMER_GROUP=onu-registration-worker

# Configuration Method: 'api', 'snmp', or 'telnet'
# - api: Use FastAPI endpoint (recommended, includes validation)
# - snmp: Direct SNMP configuration (requires OID discovery - not yet implemented)
# - telnet: Direct Telnet configuration (requires ONU ID in trap data)
CONFIG_METHOD=telnet

# API Configuration (when CONFIG_METHOD=api)
API_BASE_URL=http://localhost:8000

# SNMP Configuration (when CONFIG_METHOD=snmp)
SNMP_COMMUNITY=devCommunity
SNMP_VERSION=2c

# Telnet Configuration (when CONFIG_METHOD=telnet)
TELNET_USERNAME=xgate
TELNET_PASSWORD=your_password_here
TELNET_PORT=23

# Gotify Notification Configuration (Optional)
GOTIFY_URL=https://gotify.mcandres.com
GOTIFY_TOKEN=AfvvshNxqj6wk59

# ONU Default Configuration
ONU_DHCP_ENABLE=true
ONU_GEMPORT=1
ONU_IPHOST=1
ONU_MODE=tag
ONU_TYPE=ZTE-F622
ONU_PING_RESPONSE=true
ONU_SERVICE_PORT=1
ONU_SWITCHPORT_BIND=switch_0/1
ONU_TCONT=1
ONU_TCONT_PROFILE=10M
ONU_TRACEROUTE_RESPONSE=true
ONU_USER_VLAN=100
ONU_VLAN=100
ONU_VLAN_PORT=eth_0/1
ONU_VPORT=1

# Logging
LOG_LEVEL=INFO
